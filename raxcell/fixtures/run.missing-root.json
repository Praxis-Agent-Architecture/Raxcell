{
  "kind": "raxcell.run.v1",
  "backendPreference": ["linux-bubblewrap"],
  "policyGrants": [],
  "action": {
    "actionId": "fixture-missing-root-1",
    "ownerRuntime": "example-runtime",
    "intentLabel": "opaque command metadata",
    "metadata": {}
  },
  "command": {
    "argv": ["/usr/bin/printf", "missing-root"],
    "cwd": ".",
    "env": {},
    "stdin": null
  },
  "enforcement": {
    "profile": "workspace-write-no-network",
    "filesystem": {
      "read": ["/tmp/raxcell-fixture-root-that-should-not-exist"],
      "write": ["."]
    },
    "network": "deny",
    "process": {
      "spawn": true
    },
    "resources": {
      "timeoutMs": 1000
    }
  },
  "fallback": {
    "mode": "none"
  }
}
